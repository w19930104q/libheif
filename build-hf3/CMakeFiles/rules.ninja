  command = $PRE_LINK && /home/liiing/toolchain/root/usr/bin/x86_64-linux-gnu-g++-15 -fPIC $LANGUAGE_COMPILE_FLAGS $ARCH_FLAGS $LINK_FLAGS $SONAME_FLAG$SONAME -o $TARGET_FILE $in $LINK_PATH $LINK_LIBRARIES && $POST_BUILD
  description = Linking CXX shared library $TARGET_FILE
  restat = $RESTAT


#############################################
# Rule for creating library symlink.

rule CMAKE_SYMLINK_LIBRARY
  command = /home/liiing/.local/lib/python3.14/site-packages/cmake/data/bin/cmake -E cmake_symlink_library $in $SONAME $out && $POST_BUILD
  description = Creating library symlink $out


#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = /home/liiing/.local/lib/python3.14/site-packages/cmake/data/bin/cmake --regenerate-during-build -S/home/liiing/feedback/uid39042 -B/home/liiing/feedback/uid39042/build-hf3
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = /home/liiing/.local/bin/ninja $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


